<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:ForkPlus.Avalonia.Panels"
        x:Class="ForkPlus.Avalonia.MainWindow"
        Title="ForkPlus (Avalonia — 迁移起点)"
        Width="1100" Height="700">
  <!--
    M2 提交图放主区（跟 WPF 原版一致：commit graph 是主功能，宽面板能容下 5 列
    [decorations | graph | sha+subject | author+color | date]）。
    侧栏只放 M1 仓库 / 分支 + M4 工作区改动 + 服务说明。
  -->
  <Grid ColumnDefinitions="260,4,*" RowDefinitions="*,Auto">

    <!-- 左侧：仓库/分支 (M1) + 文件树 (M5) + 工作区 (M4) + 服务说明 -->
    <Border Grid.Column="0" Grid.Row="0" Background="#1e1e1e" Padding="12">
      <DockPanel>
        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <TextBlock FontSize="18" FontWeight="Bold">ForkPlus · Avalonia 跨平台迁移起点</TextBlock>
            <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="11">
              这是从 WPF 迁移到 Avalonia 的第一个可构建骨架。后续 UI 将逐步从 ForkPlus 的 245 个 XAML 搬运到此处。
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button x:Name="CopyButton" Content="剪贴板"/>
              <Button x:Name="ToastButton" Content="通知"/>
              <Button x:Name="DiffButton" Content="Diff Demo"/>
              <Button x:Name="PlatformButton" Content="平台服务"/>
              <Button x:Name="AiMarkdownButton" Content="AI Markdown"/>
            </StackPanel>
            <Border Background="#252526" CornerRadius="6" Padding="8">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="Bold">仓库（M1）</TextBlock>
                <DockPanel>
                  <Button x:Name="OpenRepoButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="打开"/>
                  <TextBox x:Name="RepoPathBox" Watermark="仓库路径，例如 /path/to/repo"/>
                </DockPanel>
                <TextBlock FontSize="11" Opacity="0.7">本地 / 远程分支：</TextBlock>
                <ListBox x:Name="BranchesList" Height="140"/>
              </StackPanel>
            </Border>
            <!-- M5：文件树（已抽到 FileTreePanel.xaml） -->
            <panels:FileTreePanel x:Name="FileTreePanel"/>
            <!-- M4：本地改动（已抽到 WorkingTreePanel.xaml） -->
            <panels:WorkingTreePanel x:Name="WorkingTreePanel"/>
            <Border Background="#252526" CornerRadius="6" Padding="8">
              <ScrollViewer>
                <TextBlock x:Name="ServicesText" TextWrapping="Wrap" FontFamily="monospace" FontSize="10"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" Grid.Row="0" Background="#333333" ResizeDirection="Columns"/>

    <!-- 主区：M2+M3 提交图（跟 WPF 原版同位：5 列 graph + decoration + sha/subject/author/date） -->
    <Border Grid.Column="2" Grid.Row="0" Background="#1e1e1e" Padding="12">
      <Grid RowDefinitions="*,Auto,200">
        <panels:CommitDiffPanel Grid.Row="0" x:Name="CommitDiffPanel"/>
        <!-- M5：双击文件树的文件后在这里显示原始内容 -->
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#333333"/>
        <Border Grid.Row="2" Background="#252526" CornerRadius="6" Padding="8">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" FontWeight="Bold" x:Name="FilePreviewTitle">文件内容预览（M5）</TextBlock>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="FilePreviewText" FontFamily="monospace" FontSize="12"
                         TextWrapping="NoWrap" Text="双击左侧文件树的文件项即可显示其 HEAD 内容（git show &lt;ref&gt;:&lt;path&gt;）。"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 底部：状态栏（横跨全宽） -->
    <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Background="#252526" Padding="8,4">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.9" FontFamily="monospace" FontSize="11"/>
    </Border>
  </Grid>
</Window>
