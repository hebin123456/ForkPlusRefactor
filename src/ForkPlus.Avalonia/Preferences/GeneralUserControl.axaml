<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prefs="clr-namespace:ForkPlus.Avalonia.Preferences"
             x:Class="ForkPlus.Avalonia.Preferences.GeneralUserControl"
             x:DataType="prefs:GeneralPreferencesViewModel"
             Width="500">
  <UserControl.DataTemplates>
    <DataTemplate DataType="prefs:SrcDirViewModel">
      <DockPanel LastChildFill="True" Height="22">
        <Button DockPanel.Dock="Right" Margin="2,0,0,0" Width="18" Height="18" Padding="1,0"
                Content="📂" FontSize="11" ToolTip.Tip="Edit"/>
        <TextBlock DockPanel.Dock="Left" Width="16" Height="16" Margin="0"
                   VerticalAlignment="Center" Text="📁" FontSize="12"/>
        <TextBlock FontSize="13" Margin="6,1,2,1" VerticalAlignment="Center"
                   Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Resources>
    <SolidColorBrush x:Key="HeaderBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="HintBrush" Color="#888888"/>
    <prefs:SortOrderToBoolTopoConverter x:Key="SortOrderToBoolTopo"/>
    <prefs:SortOrderToBoolDateConverter x:Key="SortOrderToBoolDate"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 0: Source Code Folder 标题 -->
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source Code Folder"
               Foreground="{StaticResource HeaderBrush}" FontWeight="Bold" FontSize="13"/>

    <!-- 1-2: 源目录 ListBox + Add/Remove 按钮 -->
    <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="110"/>
        <RowDefinition Height="22"/>
      </Grid.RowDefinitions>
      <ListBox Grid.Row="0" x:Name="SrcDirsListBox"
               ItemsSource="{Binding SourceDirs}"
               BorderBrush="#888" BorderThickness="1"
               SelectedIndex="0"/>
      <Border Grid.Row="1" BorderThickness="1,0,1,1" BorderBrush="#888" Background="#F0F0F0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AddSrcDirButton" Width="22" Height="22" Margin="-1,-1,0,-1"
                  Content="+" FontWeight="Bold" ToolTip.Tip="Add source directory"/>
          <Button x:Name="RemoveSrcDirButton" Width="22" Height="22" Margin="0,-1,0,-1"
                  Content="−" FontWeight="Bold" ToolTip.Tip="Remove selected source directory"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 3: Separator -->
    <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"/>

    <!-- 4: Diff View 标题 -->
    <TextBlock Grid.Row="4" Grid.Column="0" Text="Diff View"
               Foreground="{StaticResource HeaderBrush}" FontWeight="Bold" FontSize="13"
               Margin="0,4,0,0"/>

    <!-- 5: Diff View 预览（WPF 原版用 AvalonEdit DiffCodeEditor；M9-A 用 Border + 等宽字体占位） -->
    <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
            Height="110" Margin="10,0,0,4" BorderThickness="1" BorderBrush="#888"
            Background="#FFFFFF" Padding="6">
      <TextBlock x:Name="DiffPreviewText"
                 FontFamily="Consolas,Menlo,monospace" FontSize="12"
                 TextWrapping="NoWrap" Foreground="#222"
                 Text="diff --git forkSrcPrefix/file1.swift forkDstPrefix/file2.swift&#x0a;--- file1.swift&#x0a;+++ file2.swift&#x0a;@@ -1,3 +1,3 @@&#x0a; public func elementsEqual&lt;OtherSequence&gt;(&#x0a;-isEquivalent isEquivalent: (GElement, GElement) throws -> Bool&#x0a;+isEquivalent: (GElement, GElement) throws -> Bool"/>
    </Border>

    <!-- 6: Show -+ marks + Font size -->
    <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,5,0,0">
      <CheckBox x:Name="ShowDiffChangeMarksCheckBox"
                IsChecked="{Binding ShowDiffChangeMarks}"
                Content="Show -+ marks" VerticalAlignment="Center"/>
      <TextBlock Margin="14,4,0,0" VerticalAlignment="Center" Text="Font size:"/>
      <TextBox x:Name="CodeEditorFontSizeTextBox" Width="40" Margin="10,4,0,0"
               Text="{Binding CodeEditorFontSize, Mode=TwoWay}"/>
    </StackPanel>

    <!-- 7: Disable syntax highlighting -->
    <CheckBox Grid.Row="7" Grid.Column="1" Margin="10,8,0,0"
              x:Name="DisableSyntaxHighlightingCheckBox"
              IsChecked="{Binding DisableSyntaxHighlighting}"
              Content="Disable syntax highlighting" HorizontalAlignment="Left"/>

    <!-- 8: Separator -->
    <Separator Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,10"/>

    <!-- 9: Sort commits -->
    <TextBlock Grid.Row="9" Grid.Column="0" Text="Sort commits:" FontSize="13"
               VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <StackPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,4,0,0">
      <RadioButton x:Name="TopologicalSortOrderRadioButton"
                   GroupName="RevisionSort"
                   IsChecked="{Binding RevisionSortOrder, Converter={StaticResource SortOrderToBoolTopo}}"
                   Content="Topologically"/>
      <RadioButton x:Name="DateSortOrderRadioButton" Margin="10,0,0,0"
                   GroupName="RevisionSort"
                   IsChecked="{Binding RevisionSortOrder, Converter={StaticResource SortOrderToBoolDate}}"
                   Content="By date"/>
    </StackPanel>

    <!-- 10: Separator -->
    <Separator Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,12"/>

    <!-- 11-14: 4 个 CheckBox -->
    <CheckBox Grid.Row="11" Grid.Column="1" Margin="10,0,0,0"
              x:Name="FetchRemotesAutomaticallyCheckBox"
              IsChecked="{Binding FetchRemotesAutomatically}"
              Content="Fetch remotes automatically" HorizontalAlignment="Left"/>
    <CheckBox Grid.Row="12" Grid.Column="1" Margin="10,8,0,0"
              x:Name="FetchAllTagsCheckBox"
              IsChecked="{Binding FetchAllTags}"
              Content="Always include tags into fetch" HorizontalAlignment="Left"/>
    <CheckBox Grid.Row="13" Grid.Column="1" Margin="10,8,0,0"
              x:Name="UpdateRepoStatusAutomaticallyCheckBox"
              IsChecked="{Binding UpdateRepoStatusAutomatically}"
              Content="Tab indicator for uncommitted changes" HorizontalAlignment="Left"/>
    <CheckBox Grid.Row="14" Grid.Column="1" Margin="10,8,0,0"
              x:Name="UpdateSubmodulesAutomaticallyCheckBox"
              IsChecked="{Binding UpdateSubmodulesAutomatically}"
              Content="Update submodules automatically on checkout" HorizontalAlignment="Left"/>

    <!-- 15: Space character 替换下拉框 -->
    <StackPanel Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="10,4,0,0">
      <TextBlock Margin="23,0,0,0" VerticalAlignment="Center"
                 Foreground="{StaticResource HintBrush}"
                 Text="Space character in branch names:"/>
      <ComboBox x:Name="SpaceCharacterComboBox" Width="60" Height="22" Margin="10,0,0,0"
                ItemsSource="{x:Static prefs:GeneralPreferencesViewModel.SpaceCharacterReplacements}"
                SelectedItem="{Binding SpaceCharacterReplacement}"/>
    </StackPanel>

    <!-- 16-18: 3 个 CheckBox -->
    <CheckBox Grid.Row="16" Grid.Column="1" Margin="10,8,0,0"
              x:Name="PushAutomaticallyOnCommitCheckBox"
              IsChecked="{Binding PushAutomaticallyOnCommit}"
              Content="Push automatically on commit" HorizontalAlignment="Left"/>
    <CheckBox Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,8,0,0"
              x:Name="CompactBranchLabelsCheckBox"
              IsChecked="{Binding CompactBranchLabels}"
              Content="Compact branch labels" HorizontalAlignment="Left"/>
    <CheckBox Grid.Row="18" Grid.Column="1" Grid.ColumnSpan="3" Margin="10,8,0,0"
              x:Name="UndoRedoEnabledCheckBox"
              IsChecked="{Binding UndoRedoEnabled}"
              Content="Enable Undo/Redo (experimental, may impact performance on large repos)" HorizontalAlignment="Left"/>

    <!-- 19: Separator -->
    <Separator Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,10"/>

    <!-- 20: Language 下拉框 -->
    <TextBlock Grid.Row="20" Grid.Column="0" Text="Language:" FontSize="13"
               VerticalAlignment="Center" HorizontalAlignment="Right"/>
    <ComboBox Grid.Row="20" Grid.Column="1" Grid.ColumnSpan="2" Width="180" Margin="10,0,0,0"
              x:Name="LanguageComboBox" HorizontalAlignment="Left">
      <ComboBoxItem Content="English (US)">
        <ComboBoxItem.Tag>
          <x:String>en-US</x:String>
        </ComboBoxItem.Tag>
      </ComboBoxItem>
      <ComboBoxItem Content="中文（简体）">
        <ComboBoxItem.Tag>
          <x:String>zh-CN</x:String>
        </ComboBoxItem.Tag>
      </ComboBoxItem>
      <ComboBoxItem Content="日本語">
        <ComboBoxItem.Tag>
          <x:String>ja-JP</x:String>
        </ComboBoxItem.Tag>
      </ComboBoxItem>
      <ComboBoxItem Content="Deutsch">
        <ComboBoxItem.Tag>
          <x:String>de-DE</x:String>
        </ComboBoxItem.Tag>
      </ComboBoxItem>
    </ComboBox>
  </Grid>
</UserControl>
