# OS
.DS_Store
Thumbs.db

# Build-time downloaded native libs (CI restores to third_party/, repo only
# carries the directory as a marker so the file doesn't get re-downloaded
# on every clean build)
third_party/*.so
third_party/*.dylib
third_party/*.dll
!third_party/.gitkeep
