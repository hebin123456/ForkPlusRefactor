<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ForkPlus.Avalonia</RootNamespace>
    <AssemblyName>ForkPlus.Avalonia</AssemblyName>
    <!-- XamlX IL 编译（EnableAvaloniaXamlCompilation=true）是 Avalonia 12 生成并补丁 InitializeComponent
         的唯一途径（AvaloniaXamlLoader.Load(this) 在 12.1.1 恒抛异常，必须由 XamlX 改写为编译后 XAML IL）。 -->
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- 临时静音 nullable 警告，避免 runner 自动标注占用 biturbo-smoke 作业的注解预算，
         导致 Windows 真实加载错误被截断（M0 诊断用，后续清理）。-->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- AvalonEdit 的 Avalonia 移植（对应 ForkPlus 的 ICSharpCode.AvalonEdit.dll），用于差异视图 -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <!--
    WORKAROUND（与具体 .NET 10 SDK 版本无关）：
    .NET 10 的 Csc 任务不再触发 TargetsTriggeredByCompilation，导致 CompileAvaloniaXaml（XamlX）
    永远无法在 CoreCompile 期间运行（已多次在 CI 中确认 CAX_EXEC=0）。
    这里在 CoreCompile 之后显式调用 CompileAvaloniaXaml：此时项目程序集已生成，XamlX 用 Cecil
    直接把代码隐藏里 InitializeComponent() 的 AvaloniaXamlLoader.Load(this) 改写为编译后的 XAML IL，
    并写回同一程序集。无需 in-Csc 的二次编译。
  -->
  <Target Name="RunAvaloniaXamlCompilation" AfterTargets="CoreCompile">
    <Message Importance="high" Text="DBT_XAMLX: running CompileAvaloniaXaml after CoreCompile; IA=$(IntermediateAssembly)" />
    <ItemGroup>
      <IntermediateAssembly Update="@(IntermediateAssembly)">
        <AvaloniaCompileOutput>%(Identity)</AvaloniaCompileOutput>
      </IntermediateAssembly>
    </ItemGroup>
    <CallTarget Targets="CompileAvaloniaXaml" />
  </Target>

  <!-- M0: biturbo 原生库三平台接线（来源：原 WPF 工程 RestoreBiturbo / CopyHelperExecutables）。
       原生库不进仓库，构建期从 Biturbo 仓库最新 release 按平台拉取到 third_party/，再拷到输出目录。
       原生库提供提交图 / git / diff / md 等核心能力；其 biturbo.dll / libbiturbo.so / libbiturbo.dylib
       三平台发布物已存在（Bt.cs 的 DllImportResolver 已按 OS 重定向）。
       ContinueOnError：下载失败不让主构建失败，运行时由 BiturboSmokeTests 暴露，便于 CI 诊断。-->
  <Target Name="RestoreBiturbo" BeforeTargets="Build">
    <PropertyGroup>
      <!-- 钉到具体版本，避免 latest 解析的 302 重定向在 CI 偶发失败；v1.1.1 三平台 asset 文件名
           已核对：biturbo.dll / libbiturbo.so / libbiturbo.dylib（见 Biturbo 仓库 releases）。-->
      <BiturboVersion>v1.1.1</BiturboVersion>
      <BiturboBaseUrl>https://github.com/hebin123456/Biturbo/releases/download/$(BiturboVersion)</BiturboBaseUrl>
    </PropertyGroup>
    <Exec Condition="'$(OS)' == 'Windows_NT' And !Exists('..\..\third_party\biturbo.dll')"
          ContinueOnError="true"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; New-Item -ItemType Directory -Force -Path '..\..\third_party' | Out-Null; $url='$(BiturboBaseUrl)/biturbo.dll'; $out='..\..\third_party\biturbo.dll'; $ok=$false; for($i=1;$i -le 5;$i++){ try { Invoke-WebRequest -Uri $url -OutFile $out -UseBasicParsing -UserAgent 'ForkPlus-CI' -TimeoutSec 120; $ok=$true; break } catch { Write-Host &quot;Attempt $i failed&quot;; if($i -lt 5){ Start-Sleep -Seconds (3*$i) } } }; if(-not $ok){ Write-Host 'WARN: biturbo.dll download failed after 5 attempts' } else { Write-Host 'Restored biturbo.dll' }&quot;" />
    <Exec Condition="'$(OS)' == 'Unix' And !Exists('..\..\third_party\libbiturbo.so') And !Exists('..\..\third_party\libbiturbo.dylib')"
          ContinueOnError="true"
          Command="bash -c 'set -e; mkdir -p ../../third_party; os=`uname -s`; if [ &quot;$os&quot; = &quot;Darwin&quot; ]; then url=&quot;$(BiturboBaseUrl)/libbiturbo.dylib&quot;; out=&quot;../../third_party/libbiturbo.dylib&quot;; else url=&quot;$(BiturboBaseUrl)/libbiturbo.so&quot;; out=&quot;../../third_party/libbiturbo.so&quot;; fi; curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors &quot;$url&quot; -o &quot;$out&quot; &amp;&amp; echo &quot;Restored $out&quot; || echo &quot;WARN: $out download failed after retries&quot;'" />
  </Target>

  <Target Name="CopyBiturboToOutput" AfterTargets="Build">
    <Copy SourceFiles="..\..\third_party\biturbo.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\biturbo.dll')" />
    <Copy SourceFiles="..\..\third_party\libbiturbo.so" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\libbiturbo.so')" />
    <Copy SourceFiles="..\..\third_party\libbiturbo.dylib" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('..\..\third_party\libbiturbo.dylib')" />
  </Target>

</Project>
