<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chart="clr-namespace:ForkPlus.Avalonia.Chart"
        x:Class="ForkPlus.Avalonia.PlatformServicesDemoWindow"
        Title="平台服务 Demo (P3)"
        Width="780" Height="640">
  <TabControl Margin="16">
    <!-- 主题：替代 WinRT UISettings + 注册表 AppsUseLightTheme + SystemEvents.UserPreferenceChanged -->
    <TabItem Header="主题 (SystemThemeHelper)">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock FontSize="16" FontWeight="Bold">系统主题检测（跨平台）</TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.8">
          原 WPF 用三套机制（WinRT UISettings / 注册表 / SystemEvents）拼出系统明暗与变化事件；
          此处统一为 Avalonia 的 PlatformThemeVariantManager。
        </TextBlock>
        <DockPanel>
          <TextBlock Text="系统当前变体：" VerticalAlignment="Center"/>
          <TextBlock x:Name="ThemeSystemText" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel>
          <TextBlock Text="应用请求变体：" VerticalAlignment="Center"/>
          <TextBlock x:Name="ThemeRequestedText" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ThemeDarkBtn" Content="切换到深色"/>
          <Button x:Name="ThemeLightBtn" Content="切换到浅色"/>
          <Button x:Name="ThemeSystemBtn" Content="跟随系统"/>
        </StackPanel>
        <TextBlock FontWeight="Bold" Margin="0,8,0,0">系统主题变化事件日志</TextBlock>
        <TextBox x:Name="ThemeLog" IsReadOnly="True" AcceptsReturn="True" Height="160" FontFamily="Consolas"/>
      </StackPanel>
    </TabItem>

    <!-- 凭据：替代 WindowsCredentialManager（advapi32 CredMan）→ 分平台后端 -->
    <TabItem Header="凭据 (WindowsCredentialManager)">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock FontSize="16" FontWeight="Bold">跨平台凭据管理</TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.8">
          原 WPF 经 advapi32 CredRead/CredWrite 存取（仅 Windows）。
          此处按 OS 分派：Windows=CredMan / macOS=Keychain / Linux=文件存储。
        </TextBlock>
        <DockPanel>
          <TextBlock Text="Target" Width="70" VerticalAlignment="Center"/>
          <TextBox x:Name="CredTarget" Text="fork:P3Demo/token"/>
        </DockPanel>
        <DockPanel>
          <TextBlock Text="User" Width="70" VerticalAlignment="Center"/>
          <TextBox x:Name="CredUser" Text="demo-user"/>
        </DockPanel>
        <DockPanel>
          <TextBlock Text="Secret" Width="70" VerticalAlignment="Center"/>
          <TextBox x:Name="CredSecret" Text="s3cr3t-value" PasswordChar="*"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="CredSaveBtn" Content="保存"/>
          <Button x:Name="CredLoadBtn" Content="读取"/>
          <Button x:Name="CredDeleteBtn" Content="删除"/>
          <Button x:Name="CredEnumBtn" Content="枚举"/>
          <Button x:Name="CredSshBtn" Content="SSH 口令往返测试"/>
        </StackPanel>
        <TextBox x:Name="CredResult" IsReadOnly="True" AcceptsReturn="True" Height="180" FontFamily="Consolas"/>
      </StackPanel>
    </TabItem>

    <!-- 文件对话框：替代 Windows API Code Pack CommonOpenFileDialog -->
    <TabItem Header="文件对话框 (OpenDialog/CodePack)">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock FontSize="16" FontWeight="Bold">跨平台文件/目录对话框</TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.8">
          原 WPF 依赖 Windows API Code Pack 的 CommonOpenFileDialog / CommonSaveFileDialog；
          此处用 Avalonia 原生 OpenFileDialog / SaveFileDialog / OpenFolderDialog 替代。
        </TextBlock>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="FileDirBtn" Content="选择目录"/>
          <Button x:Name="FileFileBtn" Content="选择文件"/>
          <Button x:Name="FileExeBtn" Content="选择可执行文件"/>
          <Button x:Name="FileSaveBtn" Content="保存文件"/>
        </StackPanel>
        <TextBox x:Name="FileResult" IsReadOnly="True" AcceptsReturn="True" Height="300" FontFamily="Consolas"/>
      </StackPanel>
    </TabItem>

    <!-- Git 路径：替代 App.xaml.cs 写死的 git.exe / sh.exe / bash.exe / git-mm.exe -->
    <TabItem Header="Git 路径 (App.xaml.cs)">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock FontSize="16" FontWeight="Bold">跨平台 Git 工具路径解析</TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.8">
          原 WPF 把 GitPath/ShellPath/BashPath/GitMmPath 全部写死 .exe，Linux 下找不到 git.exe 直接报错
          （见验证截图 55-git-error-dialog.png）。此处按平台去/加 .exe，从 PATH 解析。
        </TextBlock>
        <Button x:Name="GitRefreshBtn" Content="重新解析并刷新" HorizontalAlignment="Left"/>
        <TextBox x:Name="GitResult" IsReadOnly="True" AcceptsReturn="True" Height="150" FontFamily="Consolas"/>
        <DockPanel>
          <TextBlock Text="FindExecutableInPath 测试：" VerticalAlignment="Center"/>
          <TextBox x:Name="GitTestName" Text="git" Width="160" Margin="8,0,0,0"/>
          <Button x:Name="GitTestBtn" Content="查找" Margin="8,0,0,0"/>
        </DockPanel>
        <TextBox x:Name="GitTestResult" IsReadOnly="True" FontFamily="Consolas"/>
      </StackPanel>
    </TabItem>

    <!-- Shell 集成：替代 shell32 AppUserModelID / CodePack 跳转列表 -->
    <TabItem Header="Shell (AppUserModelID)">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock FontSize="16" FontWeight="Bold">Shell 集成（任务栏 / 跳转列表）</TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.8">
          原 WPF 经 shell32.dll SetCurrentProcessExplicitAppUserModelID 设置任务栏分组，
          CodePack 提供跳转列表。这些本质是 Windows 专属：非 Windows 安全降级为 no-op（避免 Wine 崩溃）。
        </TextBlock>
        <DockPanel>
          <TextBlock Text="AppUserModelID" Width="120" VerticalAlignment="Center"/>
          <TextBox x:Name="ShellAppId" Text="com.squirrel.ForkPlus.ForkPlus"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ShellSetBtn" Content="设置 AppUserModelID"/>
          <Button x:Name="ShellRecentBtn" Content="添加最近文件(示例)"/>
        </StackPanel>
        <TextBox x:Name="ShellResult" IsReadOnly="True" AcceptsReturn="True" Height="120" FontFamily="Consolas"/>
      </StackPanel>
    </TabItem>

    <!-- 通知：跨平台 Toast（Linux notify-send / macOS osascript / 其他 in-app 浮层） -->
    <TabItem Header="通知 (Toast)">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock FontSize="16" FontWeight="Bold">跨平台 Toast 通知</TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.8">
          原 WPF 用 WinRT Toast（Windows.Data.Xml.Dom + Windows.UI.Notifications）。
          此处解析同一份 WinRT XML：Linux→notify-send，macOS→osascript，其他→in-app 浮层（保底一定可见）。
        </TextBlock>
        <DockPanel>
          <TextBlock Text="标题" Width="60" VerticalAlignment="Center"/>
          <TextBox x:Name="ToastTitle" Text="新通知"/>
        </DockPanel>
        <DockPanel>
          <TextBlock Text="正文" Width="60" VerticalAlignment="Center"/>
          <TextBox x:Name="ToastBody" Text="你有 3 条新通知"/>
        </DockPanel>
        <Button x:Name="ToastSendBtn" Content="发送通知" HorizontalAlignment="Left"/>
        <TextBox x:Name="ToastResult" IsReadOnly="True" AcceptsReturn="True" Height="100" FontFamily="Consolas"/>
      </StackPanel>
    </TabItem>

    <!-- 图表：替代 OxyPlot.Wpf 渲染控件（官方无 OxyPlot.Avalonia，用原生 DrawingContext 渲染同构模型） -->
    <TabItem Header="图表 (OxyPlot→原生)">
      <StackPanel Margin="12" Spacing="8">
        <TextBlock FontSize="16" FontWeight="Bold">跨平台图表（OxyPlot 同构模型）</TextBlock>
        <TextBlock TextWrapping="Wrap" Opacity="0.8">
          官方 oxyplot 仓库仅提供 Wpf/WinForms/SkiaSharp/ImageSharp/Pdf 后端，无第一方 Avalonia 包，
          且对 net10.0/Avalonia 12 兼容性无法验证。此处用 Avalonia 原生 DrawingContext 渲染
          与 OxyPlot PlotModel/Series 同构的模型，零外部依赖、跨平台一致。
        </TextBlock>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="类型" VerticalAlignment="Center"/>
          <ComboBox x:Name="ChartType" Width="140">
            <ComboBoxItem>折线（每月提交）</ComboBoxItem>
            <ComboBoxItem>柱状（每周提交）</ComboBoxItem>
            <ComboBoxItem>饼图（语言占比）</ComboBoxItem>
          </ComboBox>
        </StackPanel>
        <chart:AvaloniaChart x:Name="Chart" Height="320"/>
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
