<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="using:ForkPlus.Avalonia.Git"
             xmlns:conv="using:ForkPlus.Avalonia.Converters"
             x:Class="ForkPlus.Avalonia.Panels.FileTreePanel">
  <UserControl.Resources>
    <conv:FileTreeNodeKindToBrushConverter x:Key="KindToBrush"/>
    <conv:FileTreeNodeKindToBadgeTextConverter x:Key="KindToBadge"/>
  </UserControl.Resources>
  <Border Background="#252526" CornerRadius="6" Padding="8">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="6">
      <TextBlock Grid.Row="0" FontWeight="Bold">文件树（M5 · HEAD 的递归 ls-tree）</TextBlock>
      <TextBlock Grid.Row="1" x:Name="FileTreeSummaryText" FontSize="11" Opacity="0.7"
                 Text="开仓库后这里会列出 HEAD 的全部文件 + 目录。"/>
      <!--
        TreeView 的 ItemsSource 是根节点（虚拟根）的 Children（仓库顶层条目）。
        TreeViewItem 通过 HierarchicalDataTemplate 递归展示。
        我们用自定义的 TreeView 风格 + 头部徽章 + 缩进，避免依赖 HierarchicalDataTemplate
        编译期绑定（与项目里 FindControl 风格保持一致）。
      -->
      <TreeView Grid.Row="2" x:Name="FileTreeView" Background="Transparent"
                MinHeight="200" MaxHeight="380"
                SelectionMode="Single">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="git:FileTreeNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="22,*" Margin="0,1">
              <Border Grid.Column="0" Padding="4,1" CornerRadius="3"
                      Background="{Binding ItemType, Converter={StaticResource KindToBrush}}">
                <TextBlock Text="{Binding ItemType, Converter={StaticResource KindToBadge}}"
                           FontSize="10" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="monospace" FontSize="12"
                         VerticalAlignment="Center" Margin="4,0,0,0"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
      <DockPanel Grid.Row="3">
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新"/>
        <TextBlock Text="双击文件：右侧显示其 HEAD 内容（git show &lt;ref&gt;:&lt;path&gt;）。"
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
