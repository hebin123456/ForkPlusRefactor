<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.SaveAsPatchWindow"
        x:DataType="dialogs:SaveAsPatchViewModel"
        Width="590" SizeToContent="Height"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" FontSize="13" VerticalAlignment="Center"
                 Text="{Binding RevisionsLabel}"/>

      <Border Grid.Row="1" Height="200" Margin="0,6,0,2"
              BorderThickness="1" BorderBrush="Gray">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Revisions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="dialogs:SaveAsPatchRevisionItem">
                <ctrl:BindableGitPointView Subject="{Binding Subject}" Detail="{Binding Sha}" Margin="2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="{Binding SubmitButtonTitle}" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
