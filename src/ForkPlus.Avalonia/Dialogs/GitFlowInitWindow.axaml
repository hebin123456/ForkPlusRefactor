<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.GitFlowInitWindow"
        x:DataType="dialogs:GitFlowInitViewModel"
        Width="540" SizeToContent="Height"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="24"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Production Branch:"/>
      <ctrl:ReferenceTextBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                              Text="{Binding ProductionBranch, Mode=TwoWay}"
                              Placeholder="{Binding ProductionBranchPlaceholder}"/>

      <TextBlock Grid.Row="1" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Development Branch:"/>
      <ctrl:ReferenceTextBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                              Text="{Binding DevelopmentBranch, Mode=TwoWay}"
                              Placeholder="{Binding DevelopmentBranchPlaceholder}"/>

      <TextBlock Grid.Row="3" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Feature Prefix:"/>
      <ctrl:ReferenceTextBox Grid.Row="3" Grid.Column="1" Margin="8,4,0,4"
                              Text="{Binding FeaturePrefix, Mode=TwoWay}"
                              Placeholder="{Binding FeaturePrefixPlaceholder}"/>

      <TextBlock Grid.Row="4" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Release Prefix:"/>
      <ctrl:ReferenceTextBox Grid.Row="4" Grid.Column="1" Margin="8,4,0,4"
                              Text="{Binding ReleasePrefix, Mode=TwoWay}"
                              Placeholder="{Binding ReleasePrefixPlaceholder}"/>

      <TextBlock Grid.Row="5" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Hotfix Prefix:"/>
      <ctrl:ReferenceTextBox Grid.Row="5" Grid.Column="1" Margin="8,4,0,4"
                              Text="{Binding HotfixPrefix, Mode=TwoWay}"
                              Placeholder="{Binding HotfixPrefixPlaceholder}"/>

      <TextBlock Grid.Row="6" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Version Tag Prefix:"/>
      <ctrl:ReferenceTextBox Grid.Row="6" Grid.Column="1" Margin="8,4,0,4"
                              Text="{Binding VersionTagPrefix, Mode=TwoWay}"/>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="{Binding SubmitButtonTitle}" Width="100" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
