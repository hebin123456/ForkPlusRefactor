<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.GenerateNewSshKeyWindow"
        x:DataType="dialogs:GenerateNewSshKeyViewModel"
        SizeToContent="Height" Width="490"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Column="0" Grid.Row="0" Text="Key File Name:" FontSize="13"
                 VerticalAlignment="Center" HorizontalAlignment="Right"/>
      <ctrl:PlaceholderTextBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                                Text="{Binding KeyFileName, Mode=TwoWay}"
                                Placeholder="{Binding KeyFileNamePlaceholder}"/>

      <TextBlock Grid.Column="0" Grid.Row="1" Text="Email:" FontSize="13"
                 VerticalAlignment="Center" HorizontalAlignment="Right"/>
      <ctrl:PlaceholderTextBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                                Text="{Binding Email, Mode=TwoWay}"
                                Placeholder="{Binding EmailPlaceholder}"/>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="{Binding SubmitButtonTitle}" Width="100" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
