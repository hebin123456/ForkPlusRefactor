<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.CreateBranchWindow"
        x:DataType="dialogs:CreateBranchViewModel"
        Width="600" SizeToContent="Height"
        Title="Create Branch"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Create branch at:"/>
      <ctrl:GitPointView Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" Height="20"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Text="Branch name:"/>
      <ctrl:ReferenceTextBox Grid.Row="1" Grid.Column="1" Margin="8,5,0,0" Padding="4,2"
                             Placeholder="Enter branch name"
                             Text="{Binding Name, Mode=TwoWay}"/>
      <CheckBox Grid.Row="2" Grid.Column="1" Margin="8,5,0,0" HorizontalAlignment="Left"
                Content="Check out after create"
                IsChecked="{Binding CheckoutAfterCreate}"/>
      <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" Text="Local changes:" FontSize="13"/>
      <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
        <RadioButton Margin="8,6,0,0" GroupName="LocalChanges" Content="Don't change" FontSize="13"
                     IsChecked="{Binding LocalChanges, Converter={x:Static dialogs:LocalChangesOptionConverters.DoNotChange}, Mode=TwoWay}"/>
        <RadioButton Margin="8,6,0,0" GroupName="LocalChanges" Content="Stash and reapply" FontSize="13"
                     IsChecked="{Binding LocalChanges, Converter={x:Static dialogs:LocalChangesOptionConverters.StashAndReapply}, Mode=TwoWay}"/>
        <RadioButton Margin="8,6,0,0" GroupName="LocalChanges" Content="Discard" FontSize="13"
                     IsChecked="{Binding LocalChanges, Converter={x:Static dialogs:LocalChangesOptionConverters.Discard}, Mode=TwoWay}"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="OK" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
