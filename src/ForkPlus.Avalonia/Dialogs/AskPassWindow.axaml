<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prefs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        x:Class="ForkPlus.Avalonia.Dialogs.AskPassWindow"
        x:DataType="prefs:AskPassViewModel"
        MinHeight="170" Width="520" SizeToContent="Height"
        Title="Authentication Required">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"
                 x:Name="InputTextBlock" Text="{Binding Prompt}"/>
      <TextBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" Padding="4,2"
               IsVisible="{Binding !IsPasswordMode}"
               x:Name="InputTextBox"
               Text="{Binding Password, Mode=TwoWay}"/>
      <TextBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4" Padding="4,2"
               PasswordChar="•"
               IsVisible="{Binding IsPasswordMode}"
               x:Name="InputPasswordBox"
               Text="{Binding Password, Mode=TwoWay}"/>
      <CheckBox Grid.Column="1" Grid.Row="1" Margin="8,6,0,0" HorizontalAlignment="Left"
                x:Name="RememberCheckBox"
                IsChecked="{Binding Remember}"
                Content="Remember in Credential Manager"
                ToolTip.Tip="Remember in Windows Credential Manager"/>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="OK" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
