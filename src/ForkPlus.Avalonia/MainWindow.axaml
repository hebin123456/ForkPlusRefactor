<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:git="using:ForkPlus.Avalonia.Git"
        xmlns:conv="using:ForkPlus.Avalonia.Converters"
        x:Class="ForkPlus.Avalonia.MainWindow"
        Title="ForkPlus (Avalonia — 迁移起点)"
        Width="1100" Height="700">
  <Window.Resources>
    <conv:WorkingTreeStatusKindToBrushConverter x:Key="KindToBrush"/>
  </Window.Resources>
  <Grid ColumnDefinitions="320,4,*" RowDefinitions="*">
    <!-- 左侧：分支 / 提交列表 -->
    <Border Grid.Column="0" Background="#1e1e1e" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock FontSize="18" FontWeight="Bold">ForkPlus · Avalonia 跨平台迁移起点</TextBlock>
          <TextBlock TextWrapping="Wrap" Opacity="0.85">
            这是从 WPF 迁移到 Avalonia 的第一个可构建骨架。下方展示已接入的 7 个跨平台服务
            （原 WPF 工程 ServiceLocator 的接缝）。后续 UI 将逐步从 ForkPlus 的 245 个 XAML 搬运到此处。
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="CopyButton" Content="剪贴板"/>
            <Button x:Name="ToastButton" Content="通知"/>
            <Button x:Name="DiffButton" Content="Diff Demo"/>
            <Button x:Name="PlatformButton" Content="平台服务 Demo"/>
            <Button x:Name="AiMarkdownButton" Content="AI Markdown"/>
          </StackPanel>
          <Border Background="#252526" CornerRadius="6" Padding="8">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="Bold">仓库（M1+M2）</TextBlock>
              <DockPanel>
                <Button x:Name="OpenRepoButton" DockPanel.Dock="Right" Margin="6,0,0,0" Content="打开"/>
                <TextBox x:Name="RepoPathBox" Watermark="仓库路径，例如 /path/to/repo"/>
              </DockPanel>
              <TextBlock FontSize="11" Opacity="0.7">本地 / 远程分支：</TextBlock>
              <ListBox x:Name="BranchesList" Height="160"/>
              <TextBlock FontSize="11" Opacity="0.7" Margin="0,4,0,0">最新提交（M2 · biturbo）：</TextBlock>
              <ListBox x:Name="CommitsList" Height="160"/>
              <DockPanel Margin="0,4,0,0">
                <Button x:Name="ViewDiffButton" DockPanel.Dock="Right" Content="查看变更（M3）"/>
                <TextBlock Text="选中一个 commit 后点此按钮，或双击 commit 行，查看该次提交的全部文件 diff。"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <!-- M4：本地改动 -->
          <Border Background="#252526" CornerRadius="6" Padding="8">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="Bold">本地改动（M4）</TextBlock>
              <TextBlock x:Name="WorkingTreeSummaryText" FontSize="11" Opacity="0.7"
                         Text="开仓库后这里会列出相对 HEAD 的改动（暂存/未暂存/未跟踪）。"/>
              <ListBox x:Name="WorkingTreeList" Height="180">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="git:WorkingTreeChange">
                    <Grid ColumnDefinitions="80,*">
                      <Border Grid.Column="0" Padding="4,1" Margin="0,0,6,0" CornerRadius="3"
                              Background="{Binding Kind, Converter={StaticResource KindToBrush}}">
                        <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Path}" FontFamily="monospace" FontSize="12"/>
                        <TextBlock FontSize="10" Opacity="0.6">
                          <Run Text="staged="/><Run Text="{Binding Staged}"/>
                          <Run Text="  unstaged="/><Run Text="{Binding Unstaged}"/>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <DockPanel>
                <Button x:Name="ViewWorkingTreeDiffButton" DockPanel.Dock="Right"
                        Content="查看变更（M4）"/>
                <TextBlock Text="选中一项改动后点此按钮，或双击，查看该文件 working tree vs HEAD 的 diff。"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Background="#1e1e1e" CornerRadius="6" Padding="8" Margin="0,8,0,0">
          <ScrollViewer>
            <TextBlock x:Name="ServicesText" TextWrapping="Wrap" FontFamily="monospace" FontSize="11"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" Background="#333333" ResizeDirection="Columns"/>

    <!-- 右侧：服务说明 / 操作日志 -->
    <Border Grid.Column="2" Background="#1e1e1e" Padding="16">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="0,0,0,8">操作日志</TextBlock>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.9" FontFamily="monospace" FontSize="12"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
