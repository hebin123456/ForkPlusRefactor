<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ForkPlus.Avalonia.Controls.BindableGitPointView">
  <StackPanel Orientation="Vertical">
    <TextBlock x:Name="SubjectText" FontSize="13" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="DetailText" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
</UserControl>
