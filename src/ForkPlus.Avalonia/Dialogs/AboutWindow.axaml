<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        x:Class="ForkPlus.Avalonia.Dialogs.AboutWindow"
        x:DataType="dialogs:AboutViewModel"
        MinHeight="348" Width="240" SizeToContent="Height"
        Title="About"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20,0,20,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="0"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Width="90" Height="90"
            BorderBrush="Gray" BorderThickness="1">
      <TextBlock Text="ForkPlus" FontSize="22" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <DockPanel Grid.Row="2" Grid.Column="1" LastChildFill="False">
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,10,0,8"
                 Text="{Binding AppName}" FontSize="32"/>
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center"
                 x:Name="VersionTextBlock" Text="{Binding Version}"/>
      <Button DockPanel.Dock="Top" HorizontalAlignment="Center" Padding="0"
              Background="Transparent" BorderThickness="0" Cursor="Hand"
              Click="OnOpenHomepage">
        <TextBlock Text="{Binding HomepageUrl}" Foreground="#0066CC"
                   TextDecorations="Underline"/>
      </Button>
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                 Text="Designed and implemented by" Foreground="Gray"/>
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,4,0,4"
                 Text="{Binding Author}"/>
      <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"
                 x:Name="CopyrightTextBlock" Text="{Binding Copyright}"/>
    </DockPanel>

    <Button Grid.Row="3" Grid.Column="1" Content="Close" Width="80" HorizontalAlignment="Right"
            Margin="0,10,0,0" Click="OnClose"/>
  </Grid>
</Window>
