<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.RebaseBranchWindow"
        x:DataType="dialogs:RebaseBranchViewModel"
        Width="570" SizeToContent="Height"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="{Binding RebaseLabel}"/>
      <ctrl:GitPointView Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                         Text="{Binding SourceText, Mode=OneWay}"/>

      <TextBlock Grid.Row="1" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="{Binding OnLabel}"/>
      <ctrl:GitPointView Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                         Text="{Binding DestinationText, Mode=OneWay}"/>

      <CheckBox Grid.Row="2" Grid.Column="1" Margin="8,4,0,4" VerticalAlignment="Top"
                HorizontalAlignment="Left" Content="{Binding UpdateRefsLabel}"
                ToolTip.Tip="{Binding UpdateRefsToolTip}"
                IsChecked="{Binding UpdateRefs, Mode=TwoWay}"/>

      <ListBox Grid.Row="3" Grid.Column="1" MaxHeight="72" Margin="30,0,0,2"
               Background="{DynamicResource TextBox.Static.Background}" Padding="0"
               ItemsSource="{Binding DependentBranches}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" VerticalAlignment="Center" Width="16" Text="≡"/>
              <TextBlock Grid.Column="1" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"
                         FontSize="13" Text="{Binding}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <CheckBox Grid.Row="4" Grid.Column="1" Margin="8,4,0,4" HorizontalAlignment="Left"
                Content="{Binding AutostashLabel}"
                IsChecked="{Binding Autostash, Mode=TwoWay}"/>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="{Binding SubmitButtonTitle}" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
