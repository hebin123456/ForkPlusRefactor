<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.GitFlowStartReleaseWindow"
        x:DataType="dialogs:GitFlowStartReleaseViewModel"
        Width="520" SizeToContent="Height"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="{Binding Prefix}"/>
      <ctrl:ReferenceTextBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                              Text="{Binding Name, Mode=TwoWay}"
                              Placeholder="{Binding NamePlaceholder}"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Start at:" FontSize="13"
                 VerticalAlignment="Center" HorizontalAlignment="Right"/>
      <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                HorizontalAlignment="Stretch"
                ItemsSource="{Binding Branches}"
                SelectedItem="{Binding SelectedBranch, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="dialogs:BranchItem">
            <TextBlock Text="{Binding BranchName}" FontSize="13" VerticalAlignment="Center"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="{Binding SubmitButtonTitle}" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
