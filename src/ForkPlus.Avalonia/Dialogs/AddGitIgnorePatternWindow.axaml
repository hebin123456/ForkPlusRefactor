<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prefs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        x:Class="ForkPlus.Avalonia.Dialogs.AddGitIgnorePatternWindow"
        x:DataType="prefs:AddGitIgnorePatternViewModel"
        Width="670" SizeToContent="Height"
        Title="Add Git Ignore Pattern">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern:" FontSize="13"/>
      <TextBlock Grid.Row="0" Grid.Column="2" FontSize="11" HorizontalAlignment="Right"
                 x:Name="PatternLabelTextBlock" Text="(每行一条)"/>
      <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,4"
               Height="70" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace"
               x:Name="PatternTextBox"
               Text="{Binding Pattern, Mode=TwoWay}"/>
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Preview:" FontSize="13" Margin="0,8,0,0"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" FontSize="11" HorizontalAlignment="Right"
                 x:Name="PreviewLabelTextBlock" Text="(只读)"/>
      <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Height="140" Margin="0,4,0,4"
               TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
               x:Name="PreviewTextBox"
               Text="{Binding Preview, Mode=OneWay}"/>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="OK" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
