<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        x:Class="ForkPlus.Avalonia.Dialogs.GoToLineWindow"
        x:DataType="dialogs:GoToLineViewModel"
        Height="120" Width="250"
        Title="Go to Line"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <TextBlock DockPanel.Dock="Left" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Text="Line number:"/>
      <TextBox x:Name="LineNumberTextBox" Height="24" VerticalContentAlignment="Center"
               Text="{Binding LineNumber, Mode=TwoWay}"/>
    </DockPanel>

    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="OK" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
