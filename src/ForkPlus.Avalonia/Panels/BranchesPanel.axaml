<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="using:ForkPlus.Avalonia.Git"
             xmlns:conv="using:ForkPlus.Avalonia.Converters"
             x:Class="ForkPlus.Avalonia.Panels.BranchesPanel">
  <UserControl.Resources>
    <conv:BranchKindToBrushConverter x:Key="KindToBrush"/>
    <conv:BranchKindToBadgeTextConverter x:Key="KindToBadge"/>
    <conv:BranchCurrentToMarkerConverter x:Key="CurrentMarker"/>
    <conv:BranchCurrentToFontWeightConverter x:Key="CurrentWeight"/>
  </UserControl.Resources>
  <Border Background="#252526" CornerRadius="6" Padding="8">
    <StackPanel Spacing="6">
      <TextBlock FontWeight="Bold">分支（M8）</TextBlock>
      <TextBlock x:Name="BranchesSummaryText" FontSize="11" Opacity="0.7"
                 Text="开仓库后这里会按 本地/远程 分组列出分支。▶ 标记当前 HEAD。"
                 TextWrapping="Wrap"/>
      <TreeView x:Name="BranchesTree" Height="180">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="git:BranchTreeNode" ItemsSource="{Binding Children}">
            <Grid ColumnDefinitions="20,20,*" Margin="0,1">
              <!-- ▶ / 缩进标记 -->
              <TextBlock Grid.Column="0"
                         Text="{Binding IsCurrent, Converter={StaticResource CurrentMarker}}"
                         Foreground="#E0A040" FontFamily="monospace" FontSize="11"
                         VerticalAlignment="Center"/>
              <!-- 徽章：L / R / 空 -->
              <Border Grid.Column="1" Padding="4,1" CornerRadius="3"
                      Background="{Binding Kind, Converter={StaticResource KindToBrush}}"
                      VerticalAlignment="Center"
                      IsVisible="{Binding !IsGroup}">
                <TextBlock Text="{Binding Kind, Converter={StaticResource KindToBadge}}"
                           FontSize="10" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" FontFamily="monospace"/>
              </Border>
              <!-- 名称 -->
              <TextBlock Grid.Column="2" Text="{Binding Name}"
                         FontSize="12"
                         FontWeight="{Binding IsCurrent, Converter={StaticResource CurrentWeight}}"
                         VerticalAlignment="Center" Margin="6,0,0,0"
                         FontFamily="monospace"/>
            </Grid>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button x:Name="RefreshBranchesButton" Content="刷新"/>
        </StackPanel>
        <TextBlock Text="点分支以加载提交（M2）。"
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
