<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.CheckoutBranchWindow"
        x:DataType="dialogs:CheckoutBranchViewModel"
        MinWidth="500" MaxWidth="670" SizeToContent="WidthAndHeight"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="{Binding SwitchToLabel}"/>
      <ctrl:GitPointView Grid.Row="0" Grid.Column="1" Margin="8,0,0,0"
                         Text="{Binding SwitchToText, Mode=OneWay}"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="{Binding FastForwardToLabel}" FontSize="13"/>
      <ctrl:GitPointView Grid.Row="1" Grid.Column="1" Margin="8,5,0,0"
                         Text="{Binding FastForwardText, Mode=OneWay}"/>

      <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,0,0" VerticalAlignment="Top"
                 HorizontalAlignment="Right" Text="{Binding LocalChangesLabel}" FontSize="13"/>

      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5,0,0">
        <RadioButton GroupName="LocalChanges" Margin="8,6,0,0" VerticalAlignment="Center"
                     HorizontalAlignment="Left" FontSize="13" Content="{Binding DoNotChangeLabel}"
                     ToolTip.Tip="{Binding DoNotChangeToolTip}"
                     IsChecked="{Binding LocalChangesOption, Mode=TwoWay,
                                 Converter={x:Static dialogs:LeanBranchingRadioConverter.Instance},
                                 ConverterParameter=DoNotChange}"/>
        <RadioButton GroupName="LocalChanges" Margin="8,6,0,0" VerticalAlignment="Center"
                     HorizontalAlignment="Left" FontSize="13" Content="{Binding StashAndReapplyLabel}"
                     ToolTip.Tip="{Binding StashAndReapplyToolTip}"
                     IsChecked="{Binding LocalChangesOption, Mode=TwoWay,
                                 Converter={x:Static dialogs:LeanBranchingRadioConverter.Instance},
                                 ConverterParameter=StashAndReapply}"/>
        <RadioButton GroupName="LocalChanges" Margin="8,6,0,0" VerticalAlignment="Center"
                     HorizontalAlignment="Left" FontSize="13" Content="{Binding DiscardLabel}"
                     ToolTip.Tip="{Binding DiscardToolTip}"
                     IsChecked="{Binding LocalChangesOption, Mode=TwoWay,
                                 Converter={x:Static dialogs:LeanBranchingRadioConverter.Instance},
                                 ConverterParameter=Discard}"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="{Binding SubmitButtonTitle}" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
