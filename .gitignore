# Build outputs
bin/
obj/
out/
*.user
*.suo
.vs/

# .NET
*.dll
*.exe
*.pdb
*.deps.json
*.runtimeconfig.json

# NuGet
*.nupkg
packages/
.nuget/

# Test results
TestResults/
coverage/
*.trx
