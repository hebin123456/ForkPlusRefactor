<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        xmlns:ctrl="clr-namespace:ForkPlus.Avalonia.Controls"
        x:Class="ForkPlus.Avalonia.Dialogs.AddSubmoduleWindow"
        x:DataType="dialogs:AddSubmoduleViewModel"
        Height="200" Width="590" SizeToContent="Height"
        Title="{Binding DialogTitle}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Repository URL:"/>
      <ctrl:PlaceholderTextBox Grid.Row="0" Grid.Column="1" Margin="8,4,0,4"
                                Text="{Binding RepositoryUrl, Mode=TwoWay}"
                                Placeholder="{Binding UrlPlaceholder}"/>

      <TextBlock Grid.Row="1" Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                 HorizontalAlignment="Right" Text="Folder:"/>
      <ctrl:PlaceholderTextBox Grid.Row="1" Grid.Column="1" Margin="8,4,0,4"
                                Text="{Binding LocalPath, Mode=TwoWay}"
                                Placeholder="{Binding PathPlaceholder}"/>

      <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Margin="8,4,0,0"
                 VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis"
                 IsVisible="{Binding IsFinalPathHintVisible}"
                 Text="{Binding FinalPathHint}"/>

      <CheckBox Grid.Row="3" Grid.Column="1" Margin="8,6,0,0" HorizontalAlignment="Left"
                IsChecked="{Binding FetchNestedSubmodulesChecked, Mode=TwoWay}"
                Content="{Binding FetchNestedSubmodulesLabel}"/>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="{Binding SubmitButtonTitle}" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
