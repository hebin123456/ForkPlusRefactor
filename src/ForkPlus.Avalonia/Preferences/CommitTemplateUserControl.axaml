<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prefs="clr-namespace:ForkPlus.Avalonia.Preferences"
             x:Class="ForkPlus.Avalonia.Preferences.CommitTemplateUserControl"
             x:DataType="prefs:CommitTemplateViewModel"
             Width="400">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Commit Template"
               Foreground="#2D2D30" FontWeight="Bold" FontSize="13"/>
    <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
              x:Name="UseGlobalCommitTemplateCheckBox"
              IsChecked="{Binding UseGlobalCommitTemplate}"
              Content="Use global git configuration file" HorizontalAlignment="Left"/>
    <TextBlock Grid.Row="2" Grid.Column="1" Margin="4,0,0,4" FontSize="11"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#888"
               x:Name="CommitTemplatePathTextBlock"
               Text="{Binding CommitTemplatePath}"/>
    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4"
             Height="120" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace"
             x:Name="CommitTemplateTextBox"
             Text="{Binding CommitTemplateText}"/>

    <Separator Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,20,0,8"/>
    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
              x:Name="AddSignedOffMessageCheckBox"
              IsChecked="{Binding AddSignedOff}"
              Content="Add Signed-off-by line at the end of the commit message" HorizontalAlignment="Left"/>

    <Separator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,8"/>
    <CheckBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
              x:Name="SkipCommitMessageCheckBox"
              IsChecked="{Binding SkipCommitMessage}"
              Content="Do not require commit message" HorizontalAlignment="Left"/>

    <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
               x:Name="CommitMessageRegexLabel" Text="Commit message regex:"/>
    <TextBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"
             Height="64" TextWrapping="Wrap" AcceptsReturn="True"
             x:Name="CommitMessageRegexTextBox"
             Text="{Binding CommitMessageRegex}"/>
  </Grid>
</UserControl>
