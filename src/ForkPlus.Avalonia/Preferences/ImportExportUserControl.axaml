<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prefs="clr-namespace:ForkPlus.Avalonia.Preferences"
             x:Class="ForkPlus.Avalonia.Preferences.ImportExportUserControl"
             x:DataType="prefs:ImportExportViewModel"
             Width="500">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Export your ForkPlus configuration (settings, custom commands, accounts) to a zip file, or import a previously exported file to restore on another machine."/>
    <TextBlock Grid.Row="1" Text="Export" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
    <CheckBox Grid.Row="2" x:Name="IncludeAccountsCheckBox"
              Content="Include accounts (contains tokens/credentials)"
              IsChecked="{Binding IncludeAccounts}" Margin="10,0,0,6"/>
    <Button Grid.Row="3" x:Name="ExportButton" Content="Export to file..."
            Padding="12,4" Margin="10,0,0,0" HorizontalAlignment="Left"/>
    <Border Grid.Row="4" Height="1" Background="#888" Margin="0,14,0,14"/>
    <TextBlock Grid.Row="5" Text="Import" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
    <TextBlock Grid.Row="6" TextWrapping="Wrap" Foreground="#888" Margin="10,0,0,6"
               Text="Importing will overwrite your current configuration. ForkPlus will restart after import."/>
    <Button Grid.Row="7" x:Name="ImportButton" Content="Import from file..."
            Padding="12,4" Margin="10,0,0,0" HorizontalAlignment="Left"/>
    <TextBlock Grid.Row="8" x:Name="StatusText" Text="{Binding StatusText}"
               Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#1E6FCC"/>
  </Grid>
</UserControl>
