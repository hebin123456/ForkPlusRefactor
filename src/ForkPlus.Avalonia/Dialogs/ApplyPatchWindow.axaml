<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ForkPlus.Avalonia.Dialogs"
        x:Class="ForkPlus.Avalonia.Dialogs.ApplyPatchWindow"
        x:DataType="dialogs:ApplyPatchViewModel"
        Width="590" SizeToContent="Height"
        Title="Apply Patch"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="80"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Column="0" Text="Location:" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"
                 x:Name="LocationLabel"/>
      <TextBox Grid.Column="1" Margin="8,4,0,4" Padding="4,2"
               PlaceholderText="Select patch to apply"
               Text="{Binding Path, Mode=TwoWay}"
               x:Name="PathTextBox"/>
      <Button Grid.Column="2" Content="Browse..." Margin="4,4,0,4" Padding="8,2" Click="OnBrowse"
              x:Name="BrowseButton"/>
      <CheckBox Grid.Column="1" Grid.Row="1" Margin="8,6,0,0" HorizontalAlignment="Left"
                Content="Create commit"
                IsChecked="{Binding CreateCommit}"
                x:Name="CreateCommitsCheckBox"/>
    </Grid>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel"/>
      <Button Content="OK" Width="80" Classes="accent" Click="OnOk"/>
    </StackPanel>
  </Grid>
</Window>
